# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication Secret (MUST be a high-entropy string in production)
JWT_SECRET=super_secret_production_key_change_me_immediately

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,https://apkhub.com,https://dashboard.apkhub.com
PUBLIC_CONSOLE_URL=http://localhost:5173

# lanes-engine tester invitation delivery (server-side only)
COMPOSIO_KEY=

# Storage Configuration ('local' or 's3')
STORAGE_PROVIDER=local
S3_BUCKET=apkhub-releases
CDN_BASE_URL=https://cdn.apkhub.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── GitHub APK Storage ──
# Server-side PAT used to publish APK binaries as Release assets and to
# proxy-stream them back to clients (never exposed to clients).
GITHUB_PAT=
GITHUB_STORAGE_OWNER=Mr-Perfect-252
GITHUB_STORAGE_REPO=Apex-Hub-Storage
GITHUB_BRANCH=main

# GitHub App integration (server-side only; never expose these as VITE_ variables)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Paste the PEM contents; literal \n sequences are supported.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CONSOLE_URL=https://sproutly-dev.vercel.app

# Public HTTPS base URL for client-facing OTA download links. Must be HTTPS.
PUBLIC_BASE_URL=https://apex-hub-production.vercel.app

# Malware & Antivirus Scanning (Optional)
VIRUSTOTAL_API_KEY=
